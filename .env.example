# Local Docker Compose defaults (see docker-compose.yml — port 5436)
DATABASE_URL="postgresql://techconnect:techconnect@localhost:5436/techconnect?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3010"
# Must decode to exactly 32 bytes:
#   openssl rand -base64 32
FIELD_ENCRYPTION_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
# Optional — when unset, payroll documents store under .data/uploads
# BLOB_READ_WRITE_TOKEN=""
SEED_DEMO="true"
NODE_ENV="development"
