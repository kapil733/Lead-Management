# Copy to .env.aws (that file stays off git) and fill in the server.
#   cp .env.aws.example .env.aws
#   set -a && source .env.aws && set +a
#   ./scripts/deploy-aws.sh

DEPLOY_HOST=
DEPLOY_USER=ubuntu
DEPLOY_SSH_KEY=/absolute/path/to/your-key.pem
# DEPLOY_PORT=22
# DEPLOY_PATH=/opt/lead-management
# DEPLOY_PUBLIC_URL=http://your-public-ip
# DEPLOY_SETUP_POSTGRES=1

# Leave DATABASE_URL empty to create Postgres on the AWS server.
# DATABASE_URL=
# AUTH_SECRET=
# AUTH_URL=
# FIELD_ENCRYPTION_KEY=
